---
import '../styles/global.css';
import {href} from '../lib';
interface Props {title:string;description?:string;noindex?:boolean;}
const {title,description='Esplora composizione, fonti e date delle acque. Filtri numerici, confronto e dati di Milano per zona e periodo.',noindex=false}=Astro.props;
const canonical=new URL(Astro.url.pathname,'https://blumanio.github.io').href;
const schema=[{'@context':'https://schema.org','@type':'WebSite',name:'Acqua in chiaro',url:'https://blumanio.github.io'+href(),potentialAction:{'@type':'SearchAction',target:'https://blumanio.github.io'+href('acque/?q={search_term_string}'),'query-input':'required name=search_term_string'}},{'@context':'https://schema.org','@type':'WebPage',name:title,description,url:canonical},{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Acqua in chiaro',item:'https://blumanio.github.io'+href()},...(Astro.url.pathname===href()?[]:[{'@type':'ListItem',position:2,name:title,item:canonical}])]}];
const links=[['etichetta/','Leggere l’etichetta'],['perche-sono-diverse/','Perché sono diverse'],['metodologia/','Metodologia'],['aggiornamenti/','Aggiornamenti'],['chi-sono/','Chi sono'],['segnala/','Segnala'],['privacy/','Privacy'],['note-legali/','Note legali']];
---
<!doctype html><html lang="it"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} · Acqua in chiaro</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta name="referrer" content="strict-origin-when-cross-origin"/><meta name="color-scheme" content="light dark"/><meta name="theme-color" content="#0e6e78"/>{noindex&&<meta name="robots" content="noindex"/>}<meta property="og:type" content="website"/><meta property="og:locale" content="it_IT"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={'https://blumanio.github.io'+href('og.png')}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><link rel="icon" href={href('favicon.svg')} type="image/svg+xml"/><link rel="sitemap" href={href('sitemap.xml')}/><script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/></head><body><a href="#main" class="skip">Salta al contenuto</a><header class="header"><div class="container header-inner"><a class="brand" href={href()}><span class="brand-mark" aria-hidden="true"></span>Acqua in chiaro</a><nav aria-label="Principale"><a href={href('acque/')}>Acque</a><a href={href('confronta/')}>Confronta</a><a href={href('rubinetto/milano/')}>Rubinetto</a><a href={href('profili/')}>Guide</a></nav><button class="theme" id="theme-toggle" aria-label="Cambia tema chiaro o scuro">◐ Tema</button></div></header><main class="container" id="main"><slot/></main><footer class="footer"><div class="container"><strong>Acqua in chiaro</strong><p class="small">Un taccuino sulla composizione dell’acqua, di Mohamed El Aammari.<br/>Fonti consultate il 10 ottobre 2026. Le date di analisi possono essere precedenti.</p><div class="links"><a href={href('profili/')}>Guide alle situazioni</a>{links.map(([p,t])=><a href={href(p)}>{t}</a>)}</div><p class="small">Nessuna classifica. Nessuna pubblicità. Valori mancanti indicati con —.<br/>Per una condizione diagnosticata, segui le indicazioni del tuo medico.</p><a href="https://blumanio.github.io/">Portfolio di Mohamed ↗</a></div></footer><nav class="mobile-nav" aria-label="Navigazione mobile"><a href={href('acque/#filtri')}>Composizione</a><a href={href('acque/')}>Acque</a><a href={href('confronta/')}>Confronta</a><a href={href('rubinetto/milano/')}>Rubinetto</a></nav><script>
const button=document.querySelector('#theme-toggle');button?.addEventListener('click',()=>{const dark=document.documentElement.dataset.theme?document.documentElement.dataset.theme==='dark':matchMedia('(prefers-color-scheme:dark)').matches;document.documentElement.dataset.theme=dark?'light':'dark';});
</script></body></html>
