---
import Layout from '../layouts/Layout.astro';
import {FILTERS} from '../rules/chemistry';
import {guides} from '../data/guides';
import {waters,href} from '../lib';
import {format} from '../data/schema';
const sample=['levissima','acqua-panna','uliveto'].map(id=>waters.find(w=>w.slug===id)!);
---
<Layout title="Leggi i dati. Confronta le acque."><section class="hero"><p class="eyebrow">Taccuino di campo / N. 01 · Acque italiane</p><h1>Leggi i dati.<br/>Confronta le acque.</h1><p>La composizione, le fonti, le date.<br/>Un modo chiaro per guardare dentro una bottiglia.</p><form class="search-row" action={href('acque/')} method="get" role="search"><label class="sr-only" for="home-search">Cerca un’acqua</label><input id="home-search" name="q" type="search" placeholder="Hai una bottiglia in mano? Cercala qui…"/><button class="primary" type="submit">Cerca →</button></form><p class="small muted">20 schede · fonti dei produttori · dati mancanti sempre visibili</p></section><aside class="strip"><p>Anche il rubinetto ha dati da leggere: a Milano sono pubblicati per zona e periodo.</p><a href={href('rubinetto/milano/')}>Esplora Milano →</a></aside><section><p class="eyebrow">01 / Parti da un parametro</p><h2>Che cosa vuoi confrontare?</h2><p class="muted">Scegli un filtro di composizione. Tutti i valori sono in mg/L.</p><div class="grid chemistry">{FILTERS.slice(0,6).map(f=><a href={href('acque/?f='+f.id)}><span class="formula">{f.id==='residuo-50'?'Residuo fisso':f.label}</span><small>{f.id==='residuo-50'?'Classi numeriche del residuo a 180 °C. Apri da ≤ 50 mg/L.':f.descriptor}</small></a>)}</div><p class="eyebrow">Situazioni · prima leggi la guida</p><div class="chips">{guides.slice(0,8).map(g=><a class="chip" href={href('profili/'+g.slug+'/')}>{g.title} ↗</a>)}</div></section><details class="home-compare" id="home-comparison"><summary>Confronto senza classifiche</summary><p class="small muted">Tre schede del catalogo, in ordine alfabetico. Valori reali dalle fonti indicate; non una selezione di qualità.</p><div class="table-scroll" role="region" aria-label="Esempio di confronto con dati reali" tabindex="0"><table class="comparison-table"><thead><tr><th scope="col">Valore · mg/L</th>{[...sample].sort((a,b)=>a.name.localeCompare(b.name)).map(w=><th scope="col"><a href={href('acque/'+w.slug+'/')}>{w.name}</a></th>)}</tr></thead><tbody>{(['sodio','calcio','residuo_fisso_180'] as const).map(k=><tr><th scope="row">{k==='residuo_fisso_180'?'Residuo a 180 °C':k==='sodio'?'Sodio':'Calcio'}</th>{[...sample].sort((a,b)=>a.name.localeCompare(b.name)).map(w=><td class="mono">{format(w.composition[k])}</td>)}</tr>)}<tr><th scope="row">Analisi / fonte</th>{[...sample].sort((a,b)=>a.name.localeCompare(b.name)).map(w=><td>{w.analysis_date||'Data non dichiarata'}<a href={w.source_url}>Produttore ↗</a></td>)}</tr></tbody></table></div><p><a href={href('confronta/?ids=acqua-panna,levissima,uliveto')}>Apri questi dati nel confronto →</a></p></details><section><p class="eyebrow">02 / Gli strumenti del taccuino</p><div class="grid">{[['etichetta/','Leggere l’etichetta','Numeri, unità e date: parti da ciò che è scritto.'],['perche-sono-diverse/','Una storia nelle rocce','Il taccuino geologico dell’autore, in preparazione.'],['metodologia/','Come lavoriamo','Fonti, controlli e limiti del catalogo.']].map(([p,t,d])=><article class="card"><h3><a href={href(p)}>{t} →</a></h3><p>{d}</p></article>)}</div></section></Layout>
<script>const el=document.querySelector<HTMLDetailsElement>('#home-comparison');const mq=matchMedia('(min-width:769px)');if(el){el.open=mq.matches;mq.addEventListener('change',e=>{el.open=e.matches;});}</script>
