{
  "name": "acqua-in-chiaro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "validate": "node scripts/validate.ts",
    "build:data": "node scripts/build-data.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:data && npm run test && npm run typecheck && astro build && node scripts/harden.mjs && node scripts/check-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "qa": "npm run build && node scripts/qa.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^5.16.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "lighthouse": "^13.0.1",
    "playwright": "1.64.0",
    "typescript": "^5.9.3"
  }
}
